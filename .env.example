# Messung (tools/report-engine)
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# E-Mail: ausschließlich Web3Forms (Versand im Browser). Der Key von Kontaktformular/Nullmessung steht in lib/web3forms.ts.
# Access Key für Prüfpartner-Bewerbungen (Zustellung an das Postfach dieses Keys). Für denselben Empfänger denselben Key eintragen.
NEXT_PUBLIC_WEB3FORMS_PARTNER_KEY=
# Pro-Tarif von Web3Forms: Partner-Empfänger der Rank-&-Rent-Anfragen zusätzlich als CC (1 = an)
WEB3FORMS_PRO=

# Terminbuchung (https://…)
BOOKING_URL=

# Leads und Prüfpartner-Bewerbungen (Neon / Vercel Postgres). Ohne Wert speichert nur die Entwicklung in .data/.
DATABASE_URL=

# Vercel Cron /api/cron/cleanup (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# /admin (Basic Auth); ohne beide Werte ist /admin gesperrt
ADMIN_USER=
ADMIN_PASSWORD=

# Prüfpartner-Formular: erst nach Bestätigung der Web3Forms-Konfiguration durch Henryk auf true setzen
PARTNER_FORM_ENABLED=false
# Speicherdauer der Bewerbungen in Tagen ab dem letzten Statuswechsel (aktive Partner werden nicht gelöscht)
PARTNER_RETENTION_DAYS=365

# Profilseiten je Unternehmen: aus, bis die rechtliche Prüfung vorliegt
PROFILE_PAGES_ENABLED=false
SITE_URL=
