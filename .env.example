# Alle Umgebungsvariablen der Website – nur Namen, keine Werte. Werte stehen ausschließlich in Vercel (vercel env pull .env.local).
# E-Mail läuft ausschließlich über Web3Forms; es gibt keinen anderen E-Mail-Dienst.

# --- Datenbank: Neon Postgres über den Vercel Marketplace (setzt die Integration automatisch) ---
# Gepoolte Verbindung für Abfragen (lib/db.ts)
DATABASE_URL=
# Ungepoolte Verbindung für Migrationen (npm run db:migrate)
DATABASE_URL_UNPOOLED=
# Ausweichname, falls DATABASE_URL fehlt
POSTGRES_URL=

# --- Admin, Vorschau, Cron ---
# Benutzername für /admin (Basic Auth); ohne ADMIN_USER und ADMIN_PASSWORD ist /admin gesperrt (503)
ADMIN_USER=
# Passwort für /admin (zufällig erzeugt, nur in Vercel)
ADMIN_PASSWORD=
# Token für Redaktionsvorschau /vorschau/…?token=…
PREVIEW_TOKEN=
# Schutz der Cron-Route /api/cron/cleanup (Authorization: Bearer …); Vercel Cron sendet ihn automatisch
CRON_SECRET=

# --- Web3Forms (einziger E-Mail-Versand) ---
# Eigener Access Key für Prüfpartner-Bewerbungen (optional; ohne Wert gilt der Key des Kontaktformulars aus lib/web3forms.ts)
NEXT_PUBLIC_WEB3FORMS_PARTNER_KEY=
# 1 = Web3Forms-Pro-Tarif: Partner-Empfänger der Rank-&-Rent-Anfragen zusätzlich als CC
WEB3FORMS_PRO=

# --- Funktionsschalter ---
# Prüfpartner-Formular: false, bis Henryk die Web3Forms-Konfiguration bestätigt hat
PARTNER_FORM_ENABLED=false
# Speicherdauer der Prüfpartner-Bewerbungen in Tagen ab letztem Statuswechsel (aktive Partner werden nicht gelöscht)
PARTNER_RETENTION_DAYS=365
# Öffentliche Profilseiten je Unternehmen: false bis zur rechtlichen Prüfung
PROFILE_PAGES_ENABLED=false
# 1 = Rank-&-Rent-Entwürfe sichtbar (nie auf Vercel Production)
RANK_RENT_PREVIEW=

# --- Inhalte und Kontakt (von Henryk) ---
# Terminbuchungslink (https://…, z. B. Calendly/Cal.com); ohne Wert kein Button „Gespräch buchen“
BOOKING_URL=
# Ansprechpartner auf /fachpartner (Name ist Pflicht, sonst wird nichts angezeigt)
PARTNER_CONTACT_NAME=
# Funktion des Ansprechpartners
PARTNER_CONTACT_ROLE=
# E-Mail-Adresse des Ansprechpartners
PARTNER_CONTACT_EMAIL=

# --- Rate-Limit (optional, Upstash Redis / Vercel KV) ---
# REST-URL von Vercel KV (alternativ UPSTASH_REDIS_REST_URL)
KV_REST_API_URL=
# REST-Token von Vercel KV (alternativ UPSTASH_REDIS_REST_TOKEN)
KV_REST_API_TOKEN=
# REST-URL von Upstash Redis
UPSTASH_REDIS_REST_URL=
# REST-Token von Upstash Redis
UPSTASH_REDIS_REST_TOKEN=

# --- SEO und Analyse (optional) ---
# GA4-Mess-ID (überschreibt den Standard in lib/analytics.ts)
NEXT_PUBLIC_GA_ID=
# Google Search Console Verifizierungscode
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools Verifizierungscode
BING_SITE_VERIFICATION=
# Basis-URL für absolute Links (Standard: https://www.betreibermanager.de)
SITE_URL=

# --- KI-Messung (nur lokal / Henryk, tools/report-engine) ---
# OpenAI API Key
OPENAI_API_KEY=
# Perplexity API Key
PERPLEXITY_API_KEY=
# Gemini API Key
GEMINI_API_KEY=

# --- Nur lokal ---
# 1 = Lead-E-Mails nur in der Server-Konsole ausgeben, nicht senden
LEAD_DRY_RUN=
