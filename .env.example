# Messung (tools/report-engine)
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
GEMINI_API_KEY=

# E-Mail (Resend). Ohne Schlüssel werden E-Mails nur in der Server-Konsole ausgegeben.
RESEND_API_KEY=
EMAIL_FROM=
# Benachrichtigung über jeden bestätigten Lead
NOTIFY_EMAIL=

# Terminbuchung (https://…)
BOOKING_URL=

# Leads (Neon / Vercel Postgres). Ohne Wert speichert nur die Entwicklung in .data/store.json.
DATABASE_URL=

# Vercel Cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# /admin (Basic Auth); ohne beide Werte ist /admin gesperrt
ADMIN_USER=
ADMIN_PASSWORD=

# Profilseiten je Unternehmen: aus, bis die rechtliche Prüfung vorliegt
PROFILE_PAGES_ENABLED=false
SITE_URL=
